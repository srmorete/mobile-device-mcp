{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.srmorete/mobile-device-mcp",
  "title": "Mobile Device MCP",
  "description": "Control iOS and Android devices with multi-device and seamless Native/WebView support.",
  "version": "0.1.4",
  "repository": {
    "url": "https://github.com/srmorete/mobile-device-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@srmorete/mobile-device-mcp",
      "version": "0.1.4",
      "registryBaseUrl": "https://registry.npmjs.org",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "environmentVariables": [
    {
      "name": "MDMS_PORT_ANDROID",
      "isRequired": false,
      "isSecret": false,
      "default": "18000"
    },
    {
      "name": "MDMS_PORT_IOS",
      "isRequired": false,
      "isSecret": false,
      "default": "19000"
    }
  ]
}
